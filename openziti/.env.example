# Copy to .env and customize for your homelab DNS
#
# ZITI_CTRL_ADVERTISED_ADDRESS must resolve from every VLAN/client
# that will enroll identities (use Pi-hole local DNS record).

ZITI_CTRL_ADVERTISED_ADDRESS=ziti.homelab.local
ZITI_ROUTER_ADVERTISED_ADDRESS=ziti.homelab.local
ZITI_CTRL_ADVERTISED_PORT=1280
ZITI_ROUTER_PORT=3022
ZITI_PWD=admin
ZITI_INTERFACE=0.0.0.0

# Persist state on host instead of Docker volume:
# ZITI_HOME=./config
